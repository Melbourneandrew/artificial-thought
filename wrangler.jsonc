{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artificial-thought",
  "main": "cloudflare/dist/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "artificial-thought"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artificial-thought",
      "database_id": "463fdd4b-108a-4dde-9afc-378a39e7233e",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TASK_QUEUE",
        "queue": "artificial-thought-tasks",
        "remote": false
      }
    ],
    "consumers": [
      {
        "queue": "artificial-thought-tasks",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 4
      }
    ]
  },
  "triggers": {
    "crons": ["0 13 * * *"]
  },
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "e257374af7c5cd7179f4b237dd28c5c7",
    "CLOUDFLARE_AI_GATEWAY_ID": "default",
    "CF_ACCESS_TEAM_DOMAIN": "black-meadow-61da.cloudflareaccess.com",
    "CF_ACCESS_AUD": "be069dd53886e0910744c3b56340570ebc2d117ec574a9399215188d69369fb0",
    "NEXT_PUBLIC_URL": "https://artificial-thought.com",
    "BOARD_URL": "https://the-public-board.vercel.app/api/board",
    "BOARD_CHANNEL": "artificial-thought"
  }
}
