{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artificial-thought",
  "main": "cloudflare/dist/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "artificial-thought"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artificial-thought",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "TASK_QUEUE",
        "queue": "artificial-thought-tasks",
        "remote": false
      }
    ],
    "consumers": [
      {
        "queue": "artificial-thought-tasks",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 4
      }
    ]
  },
  "triggers": {
    "crons": ["0 13 * * *"]
  },
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "replace-with-account-id",
    "CLOUDFLARE_AI_GATEWAY_ID": "default",
    "CF_ACCESS_TEAM_DOMAIN": "your-team.cloudflareaccess.com",
    "CF_ACCESS_AUD": "replace-with-access-application-aud",
    "NEXT_PUBLIC_URL": "https://artificial-thought.com"
  }
}
